<Window x:Class="magazyn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:local="clr-namespace:magazyn" Title="Magazyn Laptopów" Height="460" Width="900">
    <Grid Background="#0c88d3">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="10,10,10,0" Background="#87d1fe">
            <Button Name="PrzyciskOdswiez" Height="30" Width="30" Margin="3,15,20,15" Background="#FF0000FF" Foreground="#FFFFFFFF" ToolTip="Odśwież" Click="PrzyciskOdswiez_Click">
                <iconpacks:PackIconMaterial xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" iconpacks:PackIconMaterial.Kind="Refresh" />
            </Button>
            <Button Name="PrzyciskEdytuj" Height="30" Width="75" Margin="0,0,20,0" Background="#FFFFFFFF" ToolTip="Edytuj Pole" Click="PrzyciskEdytuj_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="ReceiptTextEdit" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Edytuj" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
            <Button Name="PrzyciskDodaj" Height="30" Width="75" Margin="0,0,20,0" Background="#77D551" Foreground="#FFFFFFFF" ToolTip="Dodaj Pole" Click="PrzyciskDodaj_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="PlusThick" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Dodaj" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
            <Button Name="PrzyciskUsun" Height="30" Width="75" Margin="0,0,20,0" Background="#E44C5E" Foreground="#FFFFFFFF" ToolTip="Usuń Pole" Click="PrzyciskUsun_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="DeleteForever" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Usuń" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
            <Button Name="PrzyciskSzybkieDodawanie" Height="30" Width="140" Margin="20,0,20,0" Background="#FFFFFFFF" ToolTip="Włącz/Wyłącz tryb szybkiego dodawania" Click="SzybkieDodawanie_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="BarcodeScan" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Szybkie dodawanie" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
            <Button Name="PrzyciskImport" Height="30" Width="75" Margin="20,0,5,0" Background="#FFFFFFFF" ToolTip="Wykonaj import" Click="PrzyciskImport_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="FileImportOutline" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Import" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
            <Button Name="PrzyciskEksport" Height="30" Width="75" Margin="5,0,20,0" Background="#FFFFFFFF" ToolTip="Wykonaj Eksport" Click="PrzyciskEksport_Click">
                <StackPanel Orientation="Horizontal">
                    <PackIconMaterial p11:PackIconMaterial.Kind="FileExportOutline" xmlns:p11="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
                    <TextBlock Text="Eksport" FontWeight="Bold" Padding="5,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="10,5,10,10" Height="70" Background="#87d1fe" VerticalAlignment="Center">
            <TextBlock Text="Filtry:" VerticalAlignment="Center" FontWeight="Bold" Margin="5" FontSize="14" />
            <TextBlock Text="Kod kreskowy: " VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14" />
            <TextBox Name="FiltrowanieKodem" Height="23" Width="110" Margin="10,0,0,0" FontSize="14" Text="Podaj kod..." Foreground="#FFC0C0C0" GotFocus="FiltrowanieKodem_GotFocus" LostFocus="FiltrowanieKodem_LostFocus" TextChanged="Filtrowanie_TextChanged" />
            <TextBlock Text="Marka: " VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" />
            <TextBox Name="FiltrowanieMarka" Height="23" Width="110" Margin="10,0,0,0" FontSize="14" Text="Podaj marke..." Foreground="#FFC0C0C0" LostFocus="FiltrowanieMarka_LostFocus" GotFocus="FiltrowanieMarka_GotFocus" TextChanged="Filtrowanie_TextChanged" />
            <TextBlock Text="Model: " VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" />
            <TextBox Name="FiltrowanieModelem" Height="23" Width="110" Margin="10,0,0,0" FontSize="14" Text="Podaj model..." Foreground="#FFC0C0C0" LostFocus="FiltrowanieModelem_LostFocus" GotFocus="FiltrowanieModelem_GotFocus" TextChanged="Filtrowanie_TextChanged" />
            <Button HorizontalAlignment="Right" Height="30" Width="30" Margin="190,0,0,0" Background="White" x:Name="btnSortowania" Click="btnSortowania_Click">
                <iconPacks:PackIconMaterial Kind="Sort" />
            </Button>
            <ComboBox x:Name="CmbSortowanmia" Margin="-240,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Visibility="Collapsed"  SelectionChanged="CmbSortowanmia_SelectionChanged">

                <ComboBoxItem Content="Sortowanie kodem"/>
                <ComboBoxItem Content="Sortowanie marką"/>
                <ComboBoxItem Content="Sortowanie modelem"/>
                <ComboBoxItem Content="Sortowanie systemem"/>
                <ComboBoxItem Content="Sortowanie ekranem"/>
                <ComboBoxItem Content="Sortowanie ilościom"/>

            </ComboBox>
        </StackPanel>
        <ListView Name="ListaProduktow" Margin="10" Background="#FFFFFFFF" Height="220" Grid.Row="2" MouseDoubleClick="ListaProduktow_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Kod Kreskowy" Width="140" DisplayMemberBinding="{Binding KodKreskowy}" />
                    <GridViewColumn Header="Marka" Width="140" DisplayMemberBinding="{Binding Marka}" />
                    <GridViewColumn Header="Model" Width="140" DisplayMemberBinding="{Binding Model}" />
                    <GridViewColumn Header="System Operacyjny" Width="140" DisplayMemberBinding="{Binding System}" />
                    <GridViewColumn Header="Ekran (cale)" Width="106" DisplayMemberBinding="{Binding RozmiarEkranu}" />
                    <GridViewColumn Header="Ilość (szt)" Width="106" DisplayMemberBinding="{Binding Ilosc}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>